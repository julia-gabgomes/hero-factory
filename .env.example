# Variáveis usadas pelo docker-compose.yml. Copie para .env antes de subir
# o compose (docker compose lê .env automaticamente na raiz do projeto).

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hero_factory
MYSQL_USER=hero_factory
MYSQL_PASSWORD=hero_factory
# Porta publicada no host pelo docker-compose, usada por DATABASE_URL abaixo
MYSQL_PORT=3306

# String de conexão usada por apps/api (drizzle-kit e o cliente da aplicação)
# ao rodar fora do Docker (pnpm dev, pnpm db:migrate). Aponta para o MySQL
# do compose publicado em MYSQL_PORT.
DATABASE_URL=mysql://hero_factory:hero_factory@localhost:3306/hero_factory

# Node
NODE_VERSION=24

# Seed de 100k heróis ao subir o serviço migrate (idempotente). Lido pelo
# serviço `migrate` do docker-compose.yml.
SEED_ON_START=false
