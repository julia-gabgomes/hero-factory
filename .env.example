# Variáveis usadas pelo docker-compose.yml. Copie para .env antes de subir
# o compose (docker compose lê .env automaticamente na raiz do projeto).

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hero_factory
MYSQL_USER=hero_factory
MYSQL_PASSWORD=hero_factory

# Node
NODE_VERSION=24

# Seed de 100k heróis ao subir o serviço migrate (idempotente). Usado pela
# topologia completa (seção 4.2 do CLAUDE.md); nenhum serviço desta etapa
# ainda lê esta variável, pois migrate/api1/api2/worker são placeholders.
SEED_ON_START=false
